      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": -140,
      "left": 220,
      "attrs": {
        "i2cAddress": "0x3c"
      }
    },
    {
      "type": "wokwi-ds1307",
      "id": "rtc",
      "top": 80,
      "left": 220,
      "attrs": {}
    },
    {
      "type": "wokwi-microsd-card",
      "id": "sdcard",
      "top": 220,
      "left": 220,
      "attrs": {}
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn-up",
      "top": -40,
      "left": -340,
      "attrs": { "color": "green", "label": "UP",    "key": "ArrowUp"    }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn-down",
      "top": 20,
      "left": -340,
      "attrs": { "color": "green", "label": "DOWN",  "key": "ArrowDown"  }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn-left",
      "top": 80,
      "left": -340,
      "attrs": { "color": "green", "label": "LEFT",  "key": "ArrowLeft"  }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn-right",
      "top": 140,
      "left": -340,
      "attrs": { "color": "green", "label": "RIGHT", "key": "ArrowRight" }
