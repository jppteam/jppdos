# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# ESP-IDF (sdkconfig.defaults is the tracked source of truth; the full
# sdkconfig is generated from it; sdkconfig.prov is the tracked provisioning
# fragment)
build/
build-prov/
sdkconfig
sdkconfig.old
sdkconfig.bak

# LRV manufacturing keys and provisioning output (never commit)
scripts/mfr_seckey.bin
scripts/mfr_pubkey.bin
scripts/testbackup.json
# Per-run manufacturing config + ledger (ledger holds per-unit serial/hwid/pubkey records)
scripts/mfg.toml

# OTA signing key (scripts/ota_publish.py keygen). The private half belongs in
# the OTA_SIGNING_KEY repository secret and nowhere else — it cannot be rotated
# without reflashing every fielded device over USB. The public half is ignored
# too: what the firmware trusts is the C array pasted into it, not a file here.
scripts/ota_seckey.pem
scripts/ota_pubkey.pem
scripts/ledger.csv

# Temporary planning notes
CLEANUP_PLAN.md

# Docker / generated
dist/
.idf_version

# MkDocs docs-site build output (tools/docs/)
site/

# Vendored component build configs (not part of this project's config)
managed_components/**/sdkconfig.defaults

# CMake FetchContent downloads (pinned MicroPython source — see
# components/micropython/CMakeLists.txt). Outside build/ on purpose, so
# `idf.py fullclean` does not force a refetch.
.deps/

# Git metadata
.git/
